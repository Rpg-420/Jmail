{
  "name": "jmail",
  "version": "1.0.0",
  "private": true,
  "description": "Private mail on Cloudflare Email Routing with free-tier relay failover, plus a token-authenticated mail API for your own projects",
  "scripts": {
    "dev": "pnpm --filter @jmail/worker dev",
    "dev:frontend": "pnpm --filter @jmail/frontend dev",
    "build": "pnpm -r build",
    "build:frontend": "pnpm --filter @jmail/frontend build",
    "deploy": "pnpm build && pnpm --filter @jmail/worker run deploy",
    "db:migrate": "pnpm --filter @jmail/worker db:migrate",
    "db:migrate:prod": "pnpm --filter @jmail/worker db:migrate:prod",
    "test": "pnpm -r test"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "wrangler": "^4.152.0"
  }
}
